# Compose settings for the memory-history PoC (project name: mhpoc).
COMPOSE_PROJECT_NAME=mhpoc

# Images. Until the PoC images are built, run with the stock image:
#   TRINO_IMAGE=trinodb/trino:484 docker compose up -d --scale worker=2
TRINO_IMAGE=trino-memory-history:poc
PREDICTOR_IMAGE=trino-memory-history-predictor:poc

# Host ports (checked free with `ss -ltn`).
COORDINATOR_PORT=18080
PREDICTOR_PORT=18090
POSTGRES_PORT=15432

# Trino memory limits (calibrated, see workload/CALIBRATION.md).
QUERY_MAX_MEMORY_PER_NODE=1GB
QUERY_MAX_MEMORY=6GB
# Must equal QUERY_MAX_MEMORY_PER_NODE in bytes.
PER_WORKER_MEMORY_BYTES=1073741824
MIN_WORKERS=2
MAX_WORKERS=6
