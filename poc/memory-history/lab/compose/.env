# Compose settings for the lab (project name: mhlab). Host ports are on 127.0.0.1 only.
# I checked that 19000-19999 was free with `ss -ltn` before I chose these ports.
COMPOSE_PROJECT_NAME=mhlab

TRINO_IMAGE=trino-memory-history:poc
PREDICTOR_IMAGE=trino-memory-history-predictor:poc
GATE_IMAGE=trino-memory-history-gate:lab
GATEWAY_IMAGE=trinodb/trino-gateway:22
ENVOY_IMAGE=envoyproxy/envoy:v1.35.3
PYTHON_IMAGE=python:3.13-alpine

# Host ports.
POSTGRES_PORT=19432
COORDINATOR_A_PORT=19080
COORDINATOR_B_PORT=19081
PREDICTOR_A_PORT=19090
PREDICTOR_B_PORT=19091
GATE_PORT=19095
GATEWAY_PORT=19100
GATEWAY_PLAIN_PORT=19101
ENVOY_GATED_PORT=19110
ENVOY_PLAIN_PORT=19111
ENVOY_FIRST_ONLY_PORT=19112
ENVOY_GATED_BOUNDED_PORT=19113
ENVOY_ADMIN_PORT=19119

# Trino memory limits: the same as the PoC compose stack (poc/memory-history/compose/.env).
QUERY_MAX_MEMORY_PER_NODE=1GB
QUERY_MAX_MEMORY=6GB
# Must equal QUERY_MAX_MEMORY_PER_NODE in bytes.
PER_WORKER_MEMORY_BYTES=1073741824
MIN_WORKERS=2
MAX_WORKERS=6
SAFETY_FACTOR=1.5

# Gate (Contract L2). GATE_DELAY_MS is for the W4 test only.
GATE_PREDICTOR_TIMEOUT_MS=200
GATE_DELAY_MS=0

# Wait modes (Contract L6): wait, signal or bounded:<seconds>. The Envoy listener gated-bounded
# waits 65 s for the gate, so GATE_MAX_BOUNDED_SECONDS must stay below that.
GATE_DEFAULT_MODE=wait
GATE_MODE_A=
GATE_MODE_B=
GATE_MAX_BOUNDED_SECONDS=60
